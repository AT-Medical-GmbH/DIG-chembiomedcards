# Pharma Cards – Beispielkonfiguration. Kopieren nach .env und Werte setzen.
# KEINE echten Secrets ins Repository. Secrets in Vaultwarden bzw. der Server-Umgebung pflegen.

# --- Betrieb ---
PHARMA_ENV=staging                # development | staging | production
PHARMA_VERSION=local
PHARMA_WEB_PORT=8080              # nur ohne Traefik-Overlay
UVICORN_WORKERS=2
PHARMA_DAILY_GOAL=20

# --- Datenbank ---
POSTGRES_DB=pharma_cards
POSTGRES_USER=pharma
POSTGRES_PASSWORD=__aus_vaultwarden__

# --- Anmeldung ---
# local: Test-Identitäten per Header (nur Entwicklung/Staging hinter Zugangsschutz;
#        in production verweigert die API den Start)
# oidc:  Anmeldung im Browser über Authentik (Authorization Code + PKCE), Rolle aus dem Gruppen-Claim
AUTH_MODE=local
PHARMA_BOOTSTRAP_ADMIN=
OIDC_ISSUER=https://auth.at-medical.de/application/o/pharma-cards/
OIDC_JWKS_URL=https://auth.at-medical.de/application/o/pharma-cards/jwks/
OIDC_AUDIENCE=__client_id__
# Browser-Anmeldung (öffentlicher Client, KEIN Client-Secret); Redirect-URI exakt so in Authentik eintragen
OIDC_CLIENT_ID=__client_id__
OIDC_REDIRECT_URI=https://pharma.at-medical.de/auth/callback
OIDC_POST_LOGOUT_URI=https://pharma.at-medical.de/
OIDC_SCOPES=openid profile email offline_access
OIDC_ROLE_CLAIM=groups
OIDC_ROLE_MAP=pharma-admin:admin,pharma-editor:editor,pharma-reviewer-pharm:reviewer_pharm,pharma-reviewer-tox:reviewer_tox,pharma-teacher:teacher,pharma-learner:learner

# Nur Entwicklung: ungeprüfte Entwürfe für alle sichtbar (in production gesperrt)
PHARMA_SHOW_UNREVIEWED=false

# --- Downloads (PNG/PDF) ---
WITH_PLAYWRIGHT=1                 # 0 = kleineres Image, dann nur HTML-Download

# --- Einbettung / Proxy ---
# CSP-Quellen in doppelten Anführungszeichen, sonst entfernt Compose die einfachen um 'self'
FRAME_ANCESTORS="'self'"          # z. B. "'self' https://moodle.at-medical.de https://at-medical.de"
PHARMA_HOST=pharma.at-medical.de
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_MIDDLEWARES=              # z. B. Authentik-Forward-Auth für Staging
