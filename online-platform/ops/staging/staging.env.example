# Pharma Cards – STAGING. Kopieren nach online-platform/.env (chmod 600). Keine echten Secrets ins Repo.
# Platzhalter __...__ vor dem Start ersetzen. Hostnamen sind Vorschläge und mit Andreas abzustimmen.

PHARMA_ENV=staging
PHARMA_VERSION=staging-2026-10-31
UVICORN_WORKERS=2
PHARMA_DAILY_GOAL=20

POSTGRES_DB=pharma_cards
POSTGRES_USER=pharma
POSTGRES_PASSWORD=__aus_vaultwarden__          # neuer Eintrag "Pharma Cards Staging DB"

# Anmeldung über Authentik (Provider pharma-cards-staging, Client-Typ Public)
AUTH_MODE=oidc
OIDC_ISSUER=https://auth.at-medical.de/application/o/pharma-cards-staging/
OIDC_JWKS_URL=https://auth.at-medical.de/application/o/pharma-cards-staging/jwks/
OIDC_CLIENT_ID=__client_id__
OIDC_AUDIENCE=__client_id__
OIDC_REDIRECT_URI=https://__staging_host__/auth/callback
OIDC_POST_LOGOUT_URI=https://__staging_host__/
OIDC_SCOPES=openid profile email offline_access
OIDC_ROLE_CLAIM=groups
OIDC_ROLE_MAP=pharma-admin:admin,pharma-editor:editor,pharma-reviewer-pharm:reviewer_pharm,pharma-reviewer-tox:reviewer_tox,pharma-teacher:teacher,pharma-learner:learner

# Staging zeigt Lernenden NUR freigegebene Karten (wie Produktion). Reviewer sehen Entwürfe mit Banner.
PHARMA_SHOW_UNREVIEWED=false

WITH_PLAYWRIGHT=1

# Moodle LTI 1.3 (erst in Stufe 3 aktivieren, Overlay docker-compose.lti.yml)
PHARMA_PUBLIC_URL=https://__staging_host__
LTI_KEY_PATH=./secrets/lti_tool.pem
LTI_PLATFORMS='[{"issuer":"https://__moodle_host__","client_id":"__aus_moodle__","deployment_ids":["__aus_moodle__"],"auth_login_url":"https://__moodle_host__/mod/lti/auth.php","jwks_url":"https://__moodle_host__/mod/lti/certs.php"}]'

FRAME_ANCESTORS="'self' https://__moodle_host__"
PHARMA_HOST=__staging_host__
TRAEFIK_NETWORK=proxy                            # mit ATMED-traefik abgleichen (preflight.sh prüft)
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_MIDDLEWARES=                             # optional zusätzlicher Zugangsschutz in Staging
