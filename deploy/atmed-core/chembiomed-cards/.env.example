# Kopieren nach /srv/atmed/stacks/chembiomed-cards/.env – enthält KEINE Secrets.

# Tag des lokal gebauten Build-Images (Git-SHA, siehe Runbook Phase 3)
BUILDER_TAG=<git-sha>

# Runner-Token liegt außerhalb des Stacks im Vault-Verzeichnis (chmod 600, Besitzer 1001)
RUNNER_TOKEN_FILE=/srv/atmed/vault/services/chembiomed-cards/runner-token

# Hostnamen – DNS (Cloudflare, Proxy an) auf ATMED-core; laut Phase 0 frei
STAGING_HOST=staging.chembiomed-cards.de
PROD_HOST=releases.chembiomed-cards.de

# Anmeldung für Staging und Produktion (htpasswd, apr1 – bcrypt kann das Alpine-nginx nicht). Phase 0 vom 03.11.: Auf core gibt es
# keine Authentik-Forward-Auth-Middleware; Umstellung auf Authentik später (Runbook Phase 6).
SITES_HTPASSWD_FILE=/srv/atmed/vault/services/chembiomed-cards/sites.htpasswd

# Phase 0: websecure (Entrypoint-Middleware haertung-grundkopf@file), letsencrypt per DNS-Challenge
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
NGINX_VERSION=1.28-alpine
