# Kopieren nach /srv/atmed/stacks/chembiomed-cards/.env – enthält KEINE Secrets.

# Tag des lokal gebauten Build-Images (Git-SHA, siehe Runbook Phase 3)
BUILDER_TAG=<git-sha>

# Runner-Token liegt außerhalb des Stacks im Vault-Verzeichnis (chmod 600, Besitzer 1001)
RUNNER_TOKEN_FILE=/srv/atmed/vault/services/chembiomed-cards/runner-token

# Hostnamen – DNS (Cloudflare) auf ATMED-core muss vorher stehen (Vorschlag, prüfen)
STAGING_HOST=staging.chembiomed-cards.de
PROD_HOST=releases.chembiomed-cards.de

# Authentik-Forward-Auth-Middleware – existiert auf ATMED-core noch nicht (Phase 0),
# wird in Phase 4a als „authentik-forwardauth@file“ neu eingerichtet (Entscheidung Andreas 03.11.)
AUTH_MIDDLEWARE=authentik-forwardauth@file

TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
NGINX_VERSION=1.28-alpine
