# Kopieren nach /srv/atmed/stacks/forgejo/.env – enthält KEINE Secrets.
# Werte mit „prüfen“ vorher per 00-preflight-readonly.sh bestätigen.

# Forgejo v15 ist die aktuelle LTS-Linie (Stand 2026-10-26: 15.0.11). Updates: Runbook Phase 7.
FORGEJO_VERSION=15.0.11

# Hostname – DNS-Eintrag (Cloudflare) auf ATMED-core 91.99.60.101 muss vorher stehen (prüfen)
FORGEJO_HOST=git.at-medical.de

# Traefik auf ATMED-core (laut ATMED-docs: websecure / letsencrypt – prüfen)
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
