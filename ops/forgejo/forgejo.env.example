# Forgejo auf ATMED-core – Vorlage. Kopie nach /srv/forgejo/forgejo.env, chmod 600, NIE committen.
# Werte mit __…__ ersetzen; Passwörter neu erzeugen und nur in Vaultwarden ablegen.

FORGEJO_HOST=git.at-medical.de
FORGEJO_VERSION=15.0.11
FORGEJO_DB_PASSWORD=__aus_vaultwarden__

# Traefik (Namen mit ATMED-traefik abgleichen; preflight.sh prüft das Netz)
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Während der Einführung optional eine IP-Allowlist-Middleware aus der Traefik-Konfiguration
TRAEFIK_MIDDLEWARES=

# Nur für den GitHub-Import (Phase 3); danach leeren
FORGEJO_MIGRATION_DOMAINS=github.com,*.github.com,api.github.com
FORGEJO_MAIL_ENABLED=false
